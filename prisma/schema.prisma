generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String
  description String?
  status      String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
